# dc24h.conf.example
#
# v0.0.12:
#   - add ADCS/TLS 1.3 and optional TLS-only mode
#   - add hard line/output limits and phase timeouts
#
# v0.0.11:
#   - enable password, IP connection, reconnect and clone protections
#
# v0.0.09:
#   - move MariaDB credentials into a protected database.cnf beside this file
#   - add a relative database_config reference for per-hub home deployment
#
# v0.0.05:
#   - add disabled-by-default reverse DNS for user host queries
#
# v0.0.01:
#   - initial ADC hub runtime configuration
#   - use UTF-8 and en_US.UTF-8 baseline locale
#   - add MariaDB connection settings
#
# Author: gpt-5.6-sol
# Date: 2026-08-22

hub_name=dc24h.eu
hub_description=dc24h.eu Direct Connect ADC Hub
listen_address=0.0.0.0
listen_port=1511
max_clients=1024
locale=en_US.UTF-8
dns_lookup=0

# Anti-abuse (seconds unless the key is a count)
pwd_tmpban=900
password_failure_limit=5
password_failure_window=300
max_users_from_ip=10
reconnect_min_interval=2
clone_detect_count=3
clone_det_tban_time=600
clone_ip_tban_time=900

# ADCS/TLS. Replace the installation certificate with a trusted certificate.
tls_enabled=1
tls_only_mode=0
tls_port=1512
tls_certificate=/var/lib/dc24h.eu/dc24h.eu/tls/server.crt
tls_private_key=/var/lib/dc24h.eu/dc24h.eu/tls/server.key
tls_min_version=TLS1.3
tls_handshake_timeout=10

# Input/output memory limits (bytes)
mLineSizeMax=65535
max_outbuf_size=262144

# Session phase/idle timeouts (seconds)
timeout_key=10
timeout_validate_nick=15
timeout_login=30
timeout_myinfo=30
timeout_password=30
timeout_general=120

database_config=database.cnf
